{
  "name": "fusionlab360-core",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy --minify",
    "typecheck": "tsc --noEmit",
    "test:ai-retrieval": "tsx --test tests/domain/messaging/retrieval-evaluation.test.ts tests/domain/messaging/ai-chat-service.test.ts tests/domain/knowledge/relevance-policy.test.ts tests/domain/knowledge/answer-service.test.ts tests/domain/knowledge/answer-controller.test.ts tests/core/ai/evidence-answer.test.ts tests/core/ai/validated-generation.test.ts tests/core/ai/providers/hybrid.test.ts tests/bootstrap/error.test.ts tests/integrations/knowledge/vectorize/retriever.test.ts tests/domain/knowledge/retrieval-service.test.ts tests/domain/messaging/knowledge-intelligence.test.ts tests/domain/messaging/retrieval-evaluation-cases.test.ts tests/domain/messaging/retrieval-evaluation-runner.test.ts tests/domain/messaging/tenant-knowledge-retriever.test.ts tests/domain/messaging/knowledge-query-context.test.ts tests/domain/messaging/ai-pipeline.test.ts tests/domain/messaging/ai-pipeline-feature-flag.test.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "client:create": "tsx src/cli/index.ts client:create",
    "client:create-local": "tsx src/cli/index.ts client:create-local",
    "client:permissions": "tsx src/cli/index.ts client:permissions",
    "integration-event:replay": "tsx src/cli/index.ts integration-event:replay",
    "client:list": "tsx src/cli/index.ts client:list",
    "client:rotate": "tsx src/cli/index.ts client:rotate",
    "client:revoke": "tsx src/cli/index.ts client:revoke"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "jose": "^6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^26.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.142.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
